rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Clientes ──────────────────────────────────────────────────
    match /clientes/{id} {
      allow read, write: if request.auth != null;
    }

    // ── Carros ────────────────────────────────────────────────────
    match /carros/{id} {
      allow read, write: if request.auth != null;
    }

    // ── Serviços ──────────────────────────────────────────────────
    match /servicos/{id} {
      allow read, write: if request.auth != null;
    }

    // ── Peças ─────────────────────────────────────────────────────
    match /pecas/{id} {
      allow read, write: if request.auth != null;
    }

    // ── Orçamentos ────────────────────────────────────────────────
    match /orcamentos/{id} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll([
                         'clienteNome', 'veiculoModelo', 'veiculoPlaca',
                         'veiculoAno', 'total', 'status', 'createdBy'
                       ]);
      allow update, delete: if request.auth != null;

      // Aprovação pelo cliente via link assinado (sem autenticação)
      // Só permite alterar status→aprovado quando o token bate e o status atual é aguardando_assinatura
      allow update: if request.auth == null
                    && resource.data.status == 'aguardando_assinatura'
                    && resource.data.assinaturaToken != null
                    && request.resource.data.assinaturaToken == resource.data.assinaturaToken
                    && request.resource.data.status == 'aprovado'
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'aprovadoEm', 'assinatura', 'updatedAt']);
    }

    // ── Assinaturas digitais ───────────────────────────────────────
    // Leitura pública (cliente precisa ver o orçamento sem login)
    // Criação só pelo sistema autenticado
    // Update só para marcar como assinado (pendente → assinado), sem poder regravar outros campos
    match /assinaturas/{token} {
      allow read:   if true;
      allow create: if request.auth != null;
      allow update: if resource.data.status == 'pendente'
                    && request.resource.data.status == 'assinado'
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'nomeConfirmado', 'telefoneUltimos4',
                                   'ipMascarado', 'userAgent', 'assinadoEm']);
    }

    // ── Usuários ──────────────────────────────────────────────────
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Logs ──────────────────────────────────────────────────────
    match /logs/{id} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
    }

    match /fornecedores/{id} {
      allow read, write: if request.auth != null;
    }

    match /configuracoes/{id} {
      allow read, write: if request.auth != null;
    }

    match /materiais/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
